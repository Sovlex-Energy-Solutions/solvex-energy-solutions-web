# ==============================================================================
# Solvex Energy Solutions - Environment Configuration
# ==============================================================================

# Google Sheets Webhook URLs (from Google Apps Script Web App Deployments)
GOOGLE_SHEETS_SOLAR_QUOTE_FORM=https://script.google.com/macros/s/YOUR_SOLAR_QUOTE_APPS_SCRIPT_ID/exec
GOOGLE_SHEETS_PRODUCT_BUYER_ENQUIRY_FORM=https://script.google.com/macros/s/YOUR_PRODUCT_BUYER_APPS_SCRIPT_ID/exec
GOOGLE_SHEETS_FRANCHISE_APPLICATION_FORM=https://script.google.com/macros/s/YOUR_FRANCHISE_APPS_SCRIPT_ID/exec
GOOGLE_SHEETS_FRANCHISE_DEALERSHIP_FORM=https://script.google.com/macros/s/YOUR_FRANCHISE_APPS_SCRIPT_ID/exec
# Fallback / General Webhook URLs
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_APPS_SCRIPT_DEPLOYMENT_ID/exec
FRANCHISE_SHEET_WEBAPP_URL=https://script.google.com/macros/s/YOUR_FRANCHISE_APPS_SCRIPT_ID/exec

# (Optional) External CRM Webhook (Zoho / Salesforce / LeadSquared)
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=solvex_lead_secure_v1

# ==============================================================================
# Google Analytics 4 - Hidden Server-Side Configuration
# (Variables WITHOUT NEXT_PUBLIC_ are strictly protected and NEVER bundled into client JS)
# ==============================================================================

# Primary Server-Side Measurement ID (Hidden from client build bundle; resolved dynamically at runtime upon consent)
GA_MEASUREMENT_ID=G-GT7PX95GRM

# Public build-time Measurement ID
NEXT_PUBLIC_GA_ID=G-GT7PX95GRM

# GA4 Measurement Protocol API Secret (Server-only secret for authenticating server-side conversion telemetry)
GA_API_SECRET=your_ga4_measurement_protocol_secret_here

# Telemetry Salt (Server-only secret used to anonymize reference codes and IP hashes)
ANALYTICS_SALT=solvex_server_telemetry_salt_change_in_production_32chars

# Analytics Environment Gate (production, staging, development, disabled)
ANALYTICS_ENVIRONMENT=production

# Server-Side Telemetry Debug Mode (Set to false in production)
ANALYTICS_DEBUG_MODE=false
